<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eos_measurable_list" model="ir.ui.view">
        <field name="name">eos.measurable.list</field>
        <field name="model">eos.measurable</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="team_id"/>
                <field name="owner_id"/>
                <field name="goal"/>
                <field name="unit"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_eos_measurable_form" model="ir.ui.view">
        <field name="name">eos.measurable.form</field>
        <field name="model">eos.measurable</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="team_id"/>
                        <field name="owner_id"/>
                        <field name="goal"/>
                        <field name="comparison"/>
                        <field name="unit"/>
                    </group>

                    <notebook>
                        <page string="Weekly Entries">
                            <field name="entry_ids">
                                <list editable="bottom">
                                    <field name="week_date"/>
                                    <field name="value"/>
                                    <field name="goal"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eos_scorecard" model="ir.actions.act_window">
        <field name="name">Scorecard</field>
        <field name="res_model">eos.measurable</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>