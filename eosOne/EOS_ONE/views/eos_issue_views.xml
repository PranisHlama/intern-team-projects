<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eos_issue_list" model="ir.ui.view">
        <field name="name">eos.issue.list</field>
        <field name="model">eos.issue</field>
        <field name="arch" type="xml">
            <list default_order="priority_rank">
                <field name="priority_rank"/>
                <field name="name"/>
                <field name="team_id"/>
                <field name="meeting_id"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eos_issue_form" model="ir.ui.view">
        <field name="name">eos.issue.form</field>
        <field name="model">eos.issue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_discussion"
                            type="object"
                            string="Start Discussion"
                            invisible="status != 'open'"/>

                    <button name="action_create_todo"
                            type="object"
                            string="Create To-Do"
                            class="oe_highlight"
                            invisible="status == 'solved'"/>

                    <button name="action_solve"
                            type="object"
                            string="Solve Issue"
                            invisible="status == 'solved'"/>

                    <field name="status" widget="statusbar"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="team_id"/>
                        <field name="meeting_id"/>
                        <field name="priority_rank"/>
                    </group>

                    <field name="description"/>

                    <notebook>
                        <page string="Related To-Dos">
                            <field name="todo_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="owner_id"/>
                                    <field name="date_deadline"/>
                                    <field name="done"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eos_issues" model="ir.actions.act_window">
        <field name="name">Issues (IDS)</field>
        <field name="res_model">eos.issue</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>