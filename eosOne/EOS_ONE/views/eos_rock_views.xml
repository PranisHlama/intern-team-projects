<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eos_rock_list" model="ir.ui.view">
        <field name="name">eos.rock.list</field>
        <field name="model">eos.rock</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="team_id"/>
                <field name="owner_id"/>
                <field name="quarter"/>
                <field name="year"/>
                <field name="level"/>
                <field name="status" widget="badge"/>
                <field name="due_date"/>
            </list>
        </field>
    </record>

    <record id="view_eos_rock_form" model="ir.ui.view">
        <field name="name">eos.rock.form</field>
        <field name="model">eos.rock</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_issue"
                            type="object"
                            string="Create Issue"
                            invisible="status != 'off_track'"/>

                    <field name="status" widget="statusbar"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="team_id"/>
                        <field name="owner_id"/>
                        <field name="quarter"/>
                        <field name="year"/>
                        <field name="level"/>
                        <field name="due_date"/>
                    </group>

                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eos_rocks" model="ir.actions.act_window">
        <field name="name">Rocks</field>
        <field name="res_model">eos.rock</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>