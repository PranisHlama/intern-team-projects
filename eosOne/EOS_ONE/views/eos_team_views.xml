<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eos_team_list" model="ir.ui.view">
        <field name="name">eos.team.list</field>
        <field name="model">eos.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="facilitator_id"/>
                <field name="member_ids" widget="many2many_tags"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_eos_team_form" model="ir.ui.view">
        <field name="name">eos.team.form</field>
        <field name="model">eos.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="facilitator_id"/>
                        <field name="member_ids"
                               widget="many2many_tags"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Meetings">
                            <field name="meeting_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="meeting_date"/>
                                    <field name="meeting_type"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eos_teams" model="ir.actions.act_window">
        <field name="name">EOS Teams</field>
        <field name="res_model">eos.team</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>