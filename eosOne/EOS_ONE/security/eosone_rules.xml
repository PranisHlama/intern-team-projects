<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_eos_team_members" model="ir.rule">
        <field name="name">EOS Team Members</field>
        <field name="model_id" ref="model_eos_team"/>
        <field name="groups" eval="[(4, ref('group_eosone_user'))]"/>
        <field name="domain_force">
            [('member_ids', 'in', [user.id])]
        </field>
    </record>

