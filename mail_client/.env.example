# Mail Client Configuration
# Place this file at: mail_client/.env
# Module reads this automatically at startup
# System environment variables take precedence over this file

# Required: Encryption key for storing OAuth tokens and POP3 passwords
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MC_ENCRYPTION_KEY=ronishandpabinproject

# Required: Base URL for OAuth redirect (must match Google/Azure redirect URI)
# Format: https://your-odoo-domain.com (no trailing slash)
MC_BASE_URL=https://localhost:8000

# Gmail OAuth (get from Google Cloud Console)
# Redirect URI: https://your-odoo-domain.com/mail/oauth/callback
MC_GMAIL_CLIENT_ID=your-gmail-client-id
MC_GMAIL_CLIENT_SECRET=your-gmail-client-secret

# Outlook OAuth (get from Azure AD)
# Redirect URI: https://your-odoo-domain.com/mail/oauth/callback
MC_OUTLOOK_CLIENT_ID=your-outlook-client-id
MC_OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
MC_OUTLOOK_TENANT=common  # Or your Azure AD tenant ID

# Optional: JSON config file fallback path (default: /var/lib/odoo/mail-client-config.json)
# MC_CONFIG_FILE=/custom/path/mail-client-config.json
