<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mail_client" model="ir.module.category">
        <field name="name">Mail Client</field><field name="sequence">30</field>
    </record>
    <record id="privilege_mail_client" model="res.groups.privilege">
        <field name="name">Mail Client</field>
        <field name="category_id" ref="module_category_mail_client"/>
    </record>
    <record id="group_mail_client_user" model="res.groups">
        <field name="name">User</field><field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_mail_client"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_mail_client_manager" model="res.groups">
        <field name="name">Manager</field><field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_mail_client"/>
        <field name="implied_ids" eval="[(4, ref('group_mail_client_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="account_company_rule" model="ir.access">
        <field name="name">Mail account company isolation</field>
        <field name="model_id" ref="model_mail_client_account"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="account_owner_rule" model="ir.access">
        <field name="name">Mail client users own account setups</field>
        <field name="model_id" ref="model_mail_client_account"/>
        <field name="group_id" ref="group_mail_client_user"/>
        <field name="operation">cru</field>
        <field name="domain">[('owner_id', '=', user.id)]</field>
    </record>
    <record id="account_manager_rule" model="ir.access">
        <field name="name">Managers manage account metadata in allowed companies</field>
        <field name="model_id" ref="model_mail_client_account"/>
        <field name="group_id" ref="group_mail_client_manager"/>
        <field name="operation">crud</field>
        <field name="domain">[(1, '=', 1)]</field>
    </record>
</odoo>
