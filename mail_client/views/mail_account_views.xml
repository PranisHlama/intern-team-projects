<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_account_list" model="ir.ui.view">
        <field name="name">mail_client.account.list</field>
        <field name="model">mail_client.account</field>
        <field name="arch" type="xml"><list string="Account setups">
            <field name="name"/><field name="provider"/><field name="email_address"/>
            <field name="connection_state"/><field name="owner_id"/>
            <field name="company_id" groups="base.group_multi_company"/>
        </list></field>
    </record>
    <record id="view_mail_account_form" model="ir.ui.view">
        <field name="name">mail_client.account.form</field>
        <field name="model">mail_client.account</field>
        <field name="arch" type="xml"><form string="Mail account setup">
            <header><button name="action_connect" type="object" string="Connect / Reconnect" class="btn-secondary"/>
                <button name="action_disconnect" type="object" string="Disconnect" invisible="connection_state != 'connected'" confirm="Disconnect this account from Odoo? Provider mail will remain intact."/><field name="connection_state" widget="statusbar"/>
            </header>
            <sheet>
                <group><group>
                    <field name="name"/><field name="provider" readonly="id"/>
                    <field name="email_address" readonly="id" invisible="provider != 'pop3'"/>
                    <field name="owner_id"/><field name="active"/>
                </group><group>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group></group>
                <group string="POP3 + SMTP Settings" invisible="provider != 'pop3'">
                    <group>
                        <field name="pop3_username"/>
                        <field name="pop3_password"/>
                        <field name="pop3_host"/>
                        <field name="pop3_port"/>
                        <field name="smtp_host"/>
                        <field name="smtp_port"/>
                        <field name="smtp_security"/>
                    </group>
                </group>
            </sheet>
        </form></field>
    </record>
    <record id="action_mail_accounts" model="ir.actions.act_window">
        <field name="name">Account Setups</field><field name="res_model">mail_client.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
